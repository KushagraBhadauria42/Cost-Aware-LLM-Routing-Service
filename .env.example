# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- PostgreSQL (used by docker-compose.yml and application.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=llmrouter
DB_USERNAME=llmrouter
DB_PASSWORD=llmrouter

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM provider API keys (free tiers). ---
# Verify current free-tier model names/limits in each provider's docs before use:
#   Groq:       https://console.groq.com/docs/models
#   Gemini:     https://ai.google.dev/gemini-api/docs/models
#   OpenRouter: https://openrouter.ai/models?max_price=0
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_REFERER=
